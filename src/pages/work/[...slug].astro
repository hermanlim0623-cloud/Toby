---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { SITE } from '../../consts';
import { coverFor } from '../../lib/covers';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // Precomputed so the page can offer "next" without re-querying the
      // collection, and so the last study wraps back to the first rather
      // than dead-ending the reader.
      next: work[(i + 1) % work.length],
      index: i + 1,
      total: work.length,
    },
  }));
}

const { entry, next, index, total } = Astro.props;
const cover = coverFor(entry);
const { Content } = await render(entry);
const d = entry.data;
const num = String(index).padStart(2, '0');

// Only rows that are actually known. A project whose language is not
// documented shows no BUILT WITH row rather than a guessed one.
const facts = [
  { k: 'TYPE', v: d.tag },
  { k: 'USE', v: d.use },
  { k: 'ROLE', v: d.role },
  { k: 'STATUS', v: `${d.status}, ${d.timeframe.toLowerCase()}` },
  // A conditional spread rather than a filtered null: `.filter(Boolean)`
  // does not narrow the type, so the rows stay non-nullable.
  ...(d.stack.length ? [{ k: 'BUILT WITH', v: d.stack.join(', ') }] : []),
  { k: 'CAPABILITIES', v: d.capabilities.join(', ') },
];

// Built by src/pages/og/[slug].png.ts, one per project. Seo.astro resolves
// it against `site`, which is what social scrapers require.
const ogImage = `/og/${entry.id}.png`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.summary,
  about: d.tag,
  image: new URL(ogImage, Astro.site).href,
  author: { '@type': 'Person', name: 'Toby', url: SITE.url },
  keywords: d.stack.join(', '),
};
---

<Base title={`${d.title} (${SITE.name})`} description={d.summary} image={ogImage} type="article" schema={schema}>
  <article class="case" data-section={num} data-section-name={d.tag.toUpperCase()}>

    <header class="section bleed case-head" data-motion>
      <a class="link t-label case-back" href="/#work"><i>&lt;</i><span>ALL WORK</span></a>
      <SectionLabel num={num} name="Project" />
      <div class="grid case-head-grid">
        <p class="case-index t-counter" style="--c:2;"><span data-odometer>{num}</span><span class="t-muted"> / {String(total).padStart(2, '0')}</span></p>
        <h1 class="t-lg" style="--c:8; --s:5;" data-split>{d.title}</h1>
        <p class="t-body case-summary" style="--c:6; --s:5;" data-reveal>{d.summary}</p>
      </div>

      <dl class="grid case-facts">
        {facts.map((f) => (
          <div style="--c:3; --c-m:2;" data-reveal>
            <dt class="t-tiny">{f.k}</dt>
            <dd class="t-label">{f.v}</dd>
          </div>
        ))}
      </dl>
      <hr class="rule" data-rule />
    </header>

    <div class="bleed">
      <!-- `sizes` restates the box the stylesheet gives this image, because
           a browser picks its candidate from `sizes` alone and a guess that
           runs low fetches a file too small and renders it soft. The cover
           fills `.bleed`, which is the viewport less its two margins, up to
           the max-width `.case-visual` sets; both are spelled out here in
           the tokens' own terms so the two cannot drift apart.

           The widest candidate is the source's own width: past that the
           build would be upscaling a screenshot, which shows as soft text
           long before it would on a photograph. -->
      <figure class="case-visual" data-figure data-cursor="image">
        {cover
          ? (
            <Picture
              src={cover}
              widths={[640, 960, 1280, 1672]}
              sizes="min(100vw - 2 * clamp(20px, 4.4vw, 80px), 1672px)"
              formats={['avif']}
              fallbackFormat="webp"
              alt={`${d.title}, illustrative render`}
              decoding="async"
            />
          )
          : (
            <div class="case-plate on-dark">
              <span class="t-counter">{num}</span>
              <span class="t-md case-plate-title">{d.title}</span>
              <span class="t-tiny">{d.tag}, {d.timeframe}, {d.status}</span>
            </div>
          )}
        {cover && (
          <figcaption class="t-tiny case-visual-note">
            ILLUSTRATIVE RENDER. FIGURES SHOWN ARE NOT REAL OPERATIONAL DATA.
          </figcaption>
        )}
      </figure>
    </div>

    <section class="section bleed" aria-label="Before and after" data-motion>
      <SectionLabel num="/" name="Before and after" slash />
      <div class="grid ba">
        <div style="--c:5; --c-m:4;" data-reveal>
          <p class="t-tiny">BEFORE</p>
          <p class="t-body">{d.before}</p>
        </div>
        <div style="--c:5; --s:7; --c-m:4;" data-reveal>
          <p class="t-tiny">AFTER</p>
          <p class="t-body">{d.after}</p>
        </div>
      </div>
    </section>

    <!-- The project stated as a machine: what goes in, what happens to it,
         what it decides, what comes out. -->
    <section class="section bleed" aria-label="How it works" data-motion>
      <SectionLabel num="/" name="The machine" slash />
      <ol class="grid machine">
        {[
          { k: 'INPUT', v: d.machine.input },
          { k: 'PROCESS', v: d.machine.process },
          { k: 'DECISION', v: d.machine.decision },
          { k: 'OUTPUT', v: d.machine.output },
        ].map((stage, i) => (
          <li class="machine-stage" style="--c:3; --c-m:2;" data-reveal>
            <hr class="rule" data-rule />
            <span class="t-tiny"><span data-odometer>{String(i + 1).padStart(2, '0')}</span> / {stage.k}</span>
            <p class="t-label">{stage.v}</p>
          </li>
        ))}
      </ol>
    </section>

    {d.metrics.length > 0 && (
      <section class="section bleed" aria-label="Results" data-motion>
        <SectionLabel num="/" name="Results" slash />
        <ul class="grid stats">
          {d.metrics.map((m) => (
            <li class="stat" style="--c:4; --c-m:2;" data-reveal>
              <p class="t-counter">{m.value}</p>
              <p class="t-tiny">{m.label}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="section bleed" aria-label="Case study" data-motion>
      <div class="grid">
        <div class="case-body t-body" style="--c:6; --s:5;">
          <Content />
        </div>
        <aside class="case-stack" style="--c:3; --s:12;">
          {d.stack.length > 0 && (
            <div>
              <p class="t-tiny">BUILT WITH</p>
              <ul>{d.stack.map((t) => <li class="t-label">{t}</li>)}</ul>
            </div>
          )}
          <div>
            <p class="t-tiny">CAPABILITIES</p>
            <ul>{d.capabilities.map((c) => <li class="t-label">{c}</li>)}</ul>
          </div>
        </aside>
      </div>
    </section>

    <nav class="section bleed case-next" aria-label="Next project">
      <hr class="rule" data-rule />
      <a href={`/work/${next.id}/`} data-cursor="project">
        <span class="t-tiny">NEXT PROJECT</span>
        <span class="t-lg case-next-title" data-split>{next.data.title}</span>
        <span class="t-label t-muted">{next.data.tag}</span>
      </a>
    </nav>

  </article>
</Base>
