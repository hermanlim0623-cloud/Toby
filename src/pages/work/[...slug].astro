---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // Precomputed so the page can offer "next" without re-querying the
      // collection, and so the last study wraps back to the first rather
      // than dead-ending the reader.
      next: work[(i + 1) % work.length],
      index: i + 1,
      total: work.length,
    },
  }));
}

const { entry, next, index, total } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const num = String(index).padStart(2, '0');

const facts = [
  { k: 'ROLE', v: d.role },
  { k: 'YEAR', v: d.timeframe },
  { k: 'STATUS', v: d.status },
  { k: 'CATEGORY', v: d.tag },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.summary,
  about: d.tag,
  author: { '@type': 'Person', name: 'Toby', url: SITE.url },
  keywords: d.stack.join(', '),
};
---

<Base title={`${d.title} — ${SITE.name}`} description={d.summary} type="article" schema={schema}>
  <article class="case" data-section={num} data-section-name={d.tag.toUpperCase()}>

    <header class="section bleed case-head" data-motion>
      <a class="link t-label case-back" href="/#work"><i>&lt;</i><span>ALL WORK</span></a>
      <SectionLabel num={num} name="Project" />
      <div class="grid case-head-grid">
        <p class="case-index t-counter" style="--c:2;"><span data-odometer>{num}</span><span class="t-muted"> / {String(total).padStart(2, '0')}</span></p>
        <h1 class="t-lg" style="--c:8; --s:5;" data-split>{d.title}</h1>
        <p class="t-body case-summary" style="--c:6; --s:5;" data-reveal>{d.summary}</p>
      </div>

      <dl class="grid case-facts">
        {facts.map((f) => (
          <div style="--c:3; --c-m:2;" data-reveal>
            <dt class="t-tiny">{f.k}</dt>
            <dd class="t-label">{f.v}</dd>
          </div>
        ))}
      </dl>
      <hr class="rule" data-rule />
    </header>

    <div class="bleed">
      <figure class="case-visual" data-figure data-cursor="image">
        {d.cover
          ? <img src={d.cover} alt={`${d.title} — interface`} loading="lazy" decoding="async" />
          : (
            <div class="case-plate on-dark">
              <span class="t-counter">{num}</span>
              <span class="t-md case-plate-title">{d.title}</span>
              <span class="t-tiny">{d.tag} — {d.timeframe} — {d.status}</span>
            </div>
          )}
      </figure>
    </div>

    <!-- The project stated as a machine: what goes in, what happens to it,
         what it decides, what comes out. -->
    <section class="section bleed" aria-label="How it works" data-motion>
      <SectionLabel num="/" name="The machine" slash />
      <ol class="grid machine">
        {[
          { k: 'INPUT', v: d.machine.input },
          { k: 'PROCESS', v: d.machine.process },
          { k: 'DECISION', v: d.machine.decision },
          { k: 'OUTPUT', v: d.machine.output },
        ].map((stage, i) => (
          <li class="machine-stage" style="--c:3; --c-m:2;" data-reveal>
            <hr class="rule" data-rule />
            <span class="t-tiny"><span data-odometer>{String(i + 1).padStart(2, '0')}</span> / {stage.k}</span>
            <p class="t-label">{stage.v}</p>
          </li>
        ))}
      </ol>
    </section>

    {d.metrics.length > 0 && (
      <section class="section bleed" aria-label="Results" data-motion>
        <SectionLabel num="/" name="Results" slash />
        <ul class="grid stats">
          {d.metrics.map((m) => (
            <li class="stat" style="--c:4; --c-m:2;" data-reveal>
              <p class="t-counter">{m.value}</p>
              <p class="t-tiny">{m.label}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="section bleed" aria-label="Case study" data-motion>
      <div class="grid">
        <div class="case-body t-body" style="--c:6; --s:5;">
          <Content />
        </div>
        <aside class="case-stack" style="--c:3; --s:12;">
          <p class="t-tiny">STACK</p>
          <ul>{d.stack.map((s) => <li class="t-label">{s}</li>)}</ul>
        </aside>
      </div>
    </section>

    <nav class="section bleed case-next" aria-label="Next project">
      <hr class="rule" data-rule />
      <a href={`/work/${next.id}/`} data-cursor="project">
        <span class="t-tiny">NEXT PROJECT</span>
        <span class="t-lg case-next-title" data-split>{next.data.title}</span>
        <span class="t-label t-muted">{next.data.tag}</span>
      </a>
    </nav>

  </article>
</Base>
