---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { SITE } from '../consts';
---

<Base title={`404 (${SITE.name})`} description="That page does not exist.">
  <section class="section bleed" data-section="404" data-section-name="NOT FOUND">
    <SectionLabel num="/" name="Not found" slash />
    <div class="grid">
      <h1 class="t-hero" style="--c:6;">404</h1>
      <div style="--c:5; --s:8;">
        <p class="t-body" data-reveal>
          Whatever was here has moved or never existed. The index is one click away,
          and every project is listed on it.
        </p>
        <p style="margin-top:20px;">
          <a class="link t-label" href="/"><span>RETURN TO INDEX</span><i>&gt;</i></a>
        </p>
      </div>
    </div>
  </section>
</Base>
