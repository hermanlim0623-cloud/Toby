---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import HeroSlash from '../components/HeroSlash.astro';
import { SITE } from '../consts';
import { coverFor } from '../lib/covers';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

/**
 * The hover preview's image budget.
 *
 * `.work-preview` is position:fixed, so the browser counts it as on-screen
 * and `loading="lazy"` defers nothing: every preview is fetched on the
 * first paint whether or not a row is ever hovered. Seven full-width covers
 * on that path would be the whole gallery downloaded for a panel the
 * stylesheet caps at 300px.
 *
 * So the panel asks for exactly what it renders. `astro:assets` derives
 * these from the originals at build time, which is what the hand-run crop
 * script used to do, except that nothing has to remember to run it and the
 * 4:3 crop is stated here beside the 4:3 box rather than in a second file.
 */
// The stylesheet caps the panel at 300px, so that is the 1x size, and the
// 2x candidate is the 600x450 the old crop script produced by hand. `fit`
// crops the 16:9 cover into the panel's 4:3 box instead of squashing it.
const PREVIEW_WIDTH = 300;
const PREVIEW_HEIGHT = 225;

// Every number on this page is derived from the content collection rather
// than typed in, so a new project updates the counters and nothing here can
// quietly drift out of date.
// The technology section is declared rather than derived, so the order is
// curated instead of alphabetical. Derivation still happens, but as a check:
// anything a project claims has to appear in one of these lists, or the
// build fails. That keeps the curated version from quietly drifting away
// from the work it is supposed to describe.
//
// Every entry is supported by something in this repository. Spline is not
// listed: it appears nowhere in the source or its history, and the brief's
// own rule is to include a tool only if it is genuinely part of the
// workflow. (The word "spline" does occur in the history, describing the
// camera curve of the old WebGL scene, which is a different thing.)
const techGroups = [
  {
    name: 'Built with',
    items: [
      'Astro',
      'TypeScript',
      'JavaScript',
      'Python',
      'HTML / CSS',
      'Git',
      'REST APIs',
      'Google Sheets API',
    ],
  },
  {
    // Demonstrated by this repository's own history: the site previously ran
    // a scroll-driven WebGL scene built on Three.js with hand-written shader
    // nodes, and still ships GSAP and Lenis for the motion it has now.
    name: 'Interactive & 3D',
    items: [
      'Three.js',
      'WebGL',
      'GSAP',
      'Shaders',
      'Scroll-driven motion',
    ],
  },
];

const capabilityItems = [
  'Automation',
  'Bots',
  'Data processing',
  'Internal tooling',
  'Operational systems',
  'Reporting',
  'Workflow automation',
  'Interactive experiences',
];

// The drift check. A project that names a technology or capability the
// section does not list is a section that has fallen behind the work.
// Compared without case or spacing, so a project may write "HTML/CSS" while
// the section sets it as "HTML / CSS" without the check calling that drift.
const key = (v: string) => v.toLowerCase().replace(/\s+/g, '');
const declaredTech = techGroups.flatMap((g) => g.items.map(key));
const declaredCaps = capabilityItems.map(key);
for (const project of projects) {
  for (const t of project.data.stack) {
    if (!declaredTech.includes(key(t))) {
      throw new Error(`Technology "${t}" (${project.id}) is not listed in the technology section.`);
    }
  }
  for (const c of project.data.capabilities) {
    if (!declaredCaps.includes(key(c))) {
      throw new Error(`Capability "${c}" (${project.id}) is not listed in the technology section.`);
    }
  }
}

const technologies = techGroups.flatMap((g) => g.items);
const live = projects.filter((p) => p.data.status !== 'Retired');

const stats = [
  { n: projects.length, suffix: '', label: 'Projects shipped' },
  { n: live.length, suffix: '', label: 'Systems in use' },
  { n: technologies.length, suffix: '', label: 'Technologies in use' },
  { n: new Date().getFullYear(), suffix: '', label: 'Active', plain: true },
];

const skills = [
  { name: 'Automation', note: 'Removing repetitive manual steps from operational workflows' },
  { name: 'Web Development', note: 'Building interfaces used directly inside day-to-day operations' },
  { name: 'Backend & APIs', note: 'Connecting services, data and internal workflows' },
  { name: 'Data & Reporting', note: 'Turning recurring operational data into usable reports' },
  { name: 'Bots', note: 'Automating repetitive order and operational tasks' },
  { name: 'UI / UX', note: 'Interfaces designed around how people actually work' },
  { name: 'Creative Development', note: 'Interactive web experiences, motion and experimental interfaces' },
  { name: 'AI', note: 'Applied selectively, where deterministic rules are not enough' },
];

// What the work actually produces. Every item here is a category the seven
// projects already fall into; nothing is aspirational.
const builds = [
  'Internal tools',
  'Operational dashboards',
  'Automation scripts',
  'Reporting systems',
  'API integrations',
  'Workflow utilities',
  'Interactive web experiences',
];

// Role-based rather than a timeline. There is no employment history to list
// here beyond the ongoing work, and inventing one would be the least
// defensible thing on the page.
const experience = [
  {
    year: 'Ongoing',
    org: 'Operations & Automation',
    role: 'Creative Technologist',
    note: 'Embedded in the day-to-day running of a food and beverage operation, building the internal tools the team works with: dashboards, reporting jobs, order automation and the references the floor reads during service.',
  },
  {
    year: 'Practice',
    org: 'How the work happens',
    role: 'Design, build, maintain',
    note: 'Each tool is specified by watching the manual version of the job, built end to end, and then kept working as the operation changes. No handover between designing it and running it, which is why the tools tend to stay small.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#person`,
      name: 'Toby',
      jobTitle: 'Creative Technologist',
      email: `mailto:${SITE.email}`,
      description: SITE.description,
      address: { '@type': 'PostalAddress', addressCountry: SITE.location },
      knowsAbout: [...technologies, ...capabilityItems],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
      publisher: { '@id': `${SITE.url}/#person` },
    },
  ],
};
---

<Base title={SITE.title} description={SITE.description} schema={schema}>

  <span id="top"></span>

  <!-- ==================== HERO ==================== -->
  <section class="hero bleed" aria-label="Introduction" data-motion data-section="00" data-section-name="INDEX">
    <HeroSlash />

    <div class="grid hero-top">
      <h1 style="--c:6;">
        <span class="hero-slash" aria-hidden="true">/</span>
        <span class="hero-mark t-hero" data-hero-mark>
          <span class="hero-row"><span class="hero-char">T</span><span class="hero-char">O</span></span>
          <span class="hero-row"><span class="hero-char">B</span><span class="hero-char">Y</span></span>
        </span>
        <span class="sr-only">Toby, creative technologist</span>
      </h1>

      <div class="hero-say t-label" style="--c:4; --s:8;" data-hero-say>
        <p>CREATIVE TECHNOLOGIST</p>
        <p>DIGITAL SYSTEMS</p>
        <p>AUTOMATION &amp; TOOLING</p>
      </div>
    </div>

    <div class="grid hero-foot" data-hero-foot>
      <div class="hero-meta" style="--c:4;">
        <p class="t-tiny">CURRENTLY</p>
        <p class="t-label">Building operational tools in {SITE.location}</p>
      </div>
      <div class="hero-meta" style="--c:3; --s:6;">
        <p class="t-tiny">INDEX</p>
        <p class="hero-index">
          <span class="t-counter" data-odometer>{String(projects.length).padStart(2, "0")}</span>
          <span class="unit t-muted">/ PROJECTS</span>
        </p>
      </div>
      <a class="hero-scroll link t-label" style="--c:3; --s:10;" href="#about">
        <span>SCROLL DOWN</span><i class="arrow">↓</i>
      </a>
    </div>
  </section>

  <!-- ==================== 01 / ABOUT ==================== -->
  <section id="about" class="section bleed" data-motion data-section="01" data-section-name="ABOUT">
    <SectionLabel num="01" name="About" />
    <div class="grid about">
      <p class="t-lg" style="--c:7; --s:5;" data-split>
        Creative technologist building the machinery a business runs on.
      </p>
      <div class="about-body" style="--c:5; --s:5;" data-prose>
        <p class="t-body">
          I work close to the ground, inside the actual workflow of a food and
          beverage business, not from a spec document. The tools I build get
          judged the same way the kitchen does: does it work today, under
          pressure, without anyone babysitting it.
        </p>
        <p class="t-body">
          The problems I take on are the ones nobody writes a ticket for. A
          recap typed out by hand every night. A price that lives in four
          places and disagrees with itself. The same adjustment applied two
          hundred times by someone who stopped concentrating an hour ago.
          None of that is interesting work for a person, and all of it is
          load-bearing.
        </p>
        <p class="t-body">
          So I start by watching the manual version of the job rather than
          asking what it should do. Then I build the smallest thing that
          removes the step, and I keep it running. Design, code and the
          automation behind it are the same job here, which is the reason
          these tools stay small: nobody has to hand a specification to anyone
          else, so nothing gets built to cover a misunderstanding.
        </p>
      </div>
      <div class="about-meta" style="--c:3; --s:10;">
        <div data-reveal>
          <p class="t-tiny">ROLE</p>
          <p class="t-label">Creative Technologist</p>
        </div>
        <div data-reveal>
          <p class="t-tiny">BASED IN</p>
          <p class="t-label">{SITE.location}</p>
        </div>
        <div data-reveal>
          <p class="t-tiny">WORKS ACROSS</p>
          <p class="t-label">Design, development, automation</p>
        </div>
        <div data-reveal>
          <p class="t-tiny">STATUS</p>
          <p class="t-label t-accent">Available for work</p>
        </div>
      </div>
    </div>

    <!-- What the work actually produces, stated plainly. Every line is a
         category the seven projects below already fall into. -->
    <div class="builds">
      <p class="t-tiny" data-reveal>WHAT I BUILD</p>
      <ul class="grid builds-list">
        {builds.map((b, i) => (
          <li class="build-item" style="--c:3; --c-m:2;" data-reveal>
            <span class="t-tiny"><span data-odometer>{String(i + 1).padStart(2, '0')}</span> /</span>
            <span class="t-label">{b}</span>
          </li>
        ))}
      </ul>
    </div>

    <ul class="grid stats">
      {stats.map((s) => (
        <li class="stat" style="--c:3; --c-m:2;" data-reveal>
          <p class="t-counter">
            <span data-odometer>{s.plain ? String(s.n) : String(s.n).padStart(2, "0")}{s.suffix}</span>
          </p>
          <p class="t-tiny">{s.label}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ==================== 02 / SELECTED WORK ==================== -->
  <section id="work" class="section bleed" data-motion data-section="02" data-section-name="SELECTED WORK">
    <SectionLabel num="02" name="Selected Work" />
    <!-- One preview panel shared by every row. Each frame is the project's
         own screenshot when it has one, and a typographic plate built from
         its number, title and category when it does not, so the interaction
         is real before the photography exists. -->
    <div class="work-preview" data-work-preview aria-hidden="true">
      {projects.map((p, i) => (
        <figure class="work-frame" data-preview={p.id}>
          {coverFor(p)
            ? (
              <Picture
                src={coverFor(p)!}
                width={PREVIEW_WIDTH}
                height={PREVIEW_HEIGHT}
                densities={[2]}
                fit="cover"
                position="center"
                formats={['avif']}
                fallbackFormat="webp"
                alt=""
                decoding="async"
              />
            )
            : (
              <div class="work-plate on-dark">
                <span class="t-counter">{String(i + 1).padStart(2, '0')}</span>
                <span class="t-label work-plate-title">{p.data.title}</span>
                <span class="t-tiny">{p.data.tag}, {p.data.timeframe}</span>
              </div>
            )}
        </figure>
      ))}
    </div>

    <!-- What the section is doing, in its own terms. Decorative metadata
         about the list rather than part of it, so it is hidden from
         assistive technology; the list itself is always in final order. -->
    <p class="work-status t-tiny" data-work-status data-state="done" aria-hidden="true">
      <span>{projects.length} RECORDS</span>
    </p>

    <ul class="work-list" data-work-list>
      {projects.map((p, i) => (
        <li class="work-row">
          <a href={`/work/${p.id}/`} data-work-row data-preview={p.id} data-cursor="project">
            <span class="work-num t-counter">{String(i + 1).padStart(2, '0')}</span>
            <span class="work-title t-lg">{p.data.title}</span>
            <span class="work-cat t-label t-muted">{p.data.tag}</span>
            <span class="work-year t-label t-muted">{p.data.timeframe}</span>
            <span class="work-go t-label" aria-hidden="true">&gt;</span>
          </a>
          <hr class="rule" data-rule />
        </li>
      ))}
    </ul>
  </section>

  <!-- ==================== 03 / EXPERIENCE ==================== -->
  <section id="experience" class="section bleed" data-motion data-section="03" data-section-name="EXPERIENCE">
    <SectionLabel num="03" name="Experience" />
    <ul class="exp-list">
      {experience.map((e) => (
        <li class="exp-row">
          <hr class="rule" data-rule />
          <div class="exp-inner" data-reveal>
            <span class="t-counter exp-year">{e.year}</span>
            <span class="t-lg exp-org">{e.org}</span>
            <span class="t-label t-muted exp-role">{e.role}</span>
            <p class="t-body exp-note">{e.note}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- ==================== 04 / SKILLS ==================== -->
  <section id="skills" class="section bleed" data-motion data-section="04" data-section-name="SKILLS">
    <SectionLabel num="04" name="Skills" />
    <ul class="skill-list">
      {skills.map((s, i) => (
        <li class="skill-row" data-reveal>
          <hr class="rule" data-rule />
          <div class="skill-inner">
            <span class="t-label t-muted skill-num" data-odometer>{String(i + 1).padStart(2, '0')}</span>
            <span class="t-label skill-name">{s.name}</span>
            <span class="t-label t-muted skill-note">{s.note}</span>
            <span class="t-label skill-go" aria-hidden="true">&gt;</span>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- ==================== 05 / TECHNOLOGY ====================
       The one inverted block in the document. The archive is the right
       section for it: it is a list of names rather than an argument, so the
       reader loses nothing by it going quiet and dark before the contact
       block, and the page gains a beat it does not otherwise have.

       Technologies and capabilities are listed separately on purpose.
       "Automation" and "Bots" are things the tools do, not things they are
       written in, and listing them beside Python read as though they were. -->
  <section id="technology" class="section bleed on-dark" data-tech data-cursor-theme="dark" data-motion data-section="05" data-section-name="TECHNOLOGY">
    <SectionLabel num="05" name="Technology" />

    <!-- Three groups, one row treatment. The index restarts per group so a
         reader counts within a category rather than through the section. -->
    {techGroups.map((group, gi) => (
      <div class="tech-group">
        <p class={`t-tiny tech-head${gi > 0 ? ' tech-head-second' : ''}`}>
          {group.name.toUpperCase()}
        </p>
        <ul class="grid tech-list">
          {group.items.map((item, i) => (
            <li class="tech-item" style="--c:3; --c-m:2;">
              <span class="t-tiny">{String(i + 1).padStart(2, '0')} /</span>
              <span class="t-label">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="tech-group">
      <p class="t-tiny tech-head tech-head-second">CAPABILITIES</p>
      <ul class="grid tech-list">
        {capabilityItems.map((item, i) => (
          <li class="tech-item" style="--c:3; --c-m:2;">
            <span class="t-tiny">{String(i + 1).padStart(2, '0')} /</span>
            <span class="t-label">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ==================== / CONTACT ==================== -->
  <section id="contact" class="section bleed contact" data-motion data-section="06" data-section-name="CONTACT">
    <SectionLabel num="06" name="Contact" slash />
    <h2 class="t-md contact-head" data-split>/ CONTACT</h2>

    <div class="grid contact-intro">
      <p class="t-body" style="--c:6; --s:5;" data-reveal>
        Open to technical projects, operational systems, automation work and
        creative technology. If you have a process that only works because
        somebody is holding it together by hand, that is the kind of problem
        I find interesting.
      </p>
    </div>

    <div class="grid contact-grid">
      <div style="--c:5;" data-reveal>
        <p class="t-tiny">EMAIL</p>
        <a class="link t-lg contact-mail" href={`mailto:${SITE.email}`}>
          <span>{SITE.email}</span><i>&gt;</i>
        </a>
      </div>
      <div style="--c:5; --s:8;" data-reveal>
        <p class="t-tiny">LOCATION</p>
        <p class="t-label">{SITE.location}</p>
      </div>
    </div>

    <!-- The case studies describe these systems; they do not show the real
         interfaces, which run inside a working business. Saying so is more
         useful than implying the public page is the whole picture. -->
    <div class="grid contact-request">
      <div style="--c:7; --s:5;" data-reveal>
        <hr class="rule" data-rule />
        <p class="t-tiny contact-request-label">SEEING THE REAL THING</p>
        <p class="t-body">
          The case studies describe these systems rather than show them. The
          working interfaces sit inside a live operation, so they are not
          published here. If you want to see how any of them actually looks
          and runs, ask and I will walk you through it.
        </p>
        <p class="contact-request-cta">
          <a class="link t-label" href={`mailto:${SITE.email}?subject=Walkthrough%20request`}>
            <span>REQUEST A WALKTHROUGH</span><i>&gt;</i>
          </a>
        </p>
      </div>
    </div>
  </section>

</Base>
