---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { SITE } from '../consts';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const stack = [
  "Python", "JavaScript / TypeScript", "Astro", "GSAP + ScrollTrigger",
  "Lenis", "WebGL / GLSL", "Google Sheets API", "REST APIs", "Automation scripting",
];

const experience = [
  {
    when: "Ongoing",
    title: "Operations & Automation",
    desc: "Embedded in day-to-day operations, building the dashboards, bots and reporting tools the team relies on to run service without manual bottlenecks.",
  },
];

const identityLines = [
  "> SCANNING SOURCE...",
  "> IDENTITY FOUND",
  "> DESIGNATION: TOBY",
  "> ROLE: CREATIVE TECHNOLOGIST",
  "> CORE: SYSTEMS · AUTOMATION · AI",
  "> DECLARED CAPABILITIES: 9",
];
const identityTags = [
  "AUTOMATION", "WEB DEVELOPMENT", "AI", "3D WEB", "UI/UX",
  "API & SYSTEMS", "CREATIVE TECHNOLOGY", "BOTS", "INTERACTIVE EXPERIENCES",
];

const pipelineStages = [
  { k: "INPUT", d: "Raw daily orders, recap numbers, recurring manual entries." },
  { k: "PROCESS", d: "Scripts normalize, validate and transform the incoming data." },
  { k: "DECISION", d: "Rules and thresholds decide what needs a human, what doesn't." },
  { k: "ACTION", d: "The system writes, flags, or files the result automatically." },
  { k: "OUTPUT", d: "A dashboard, a report, or a completed record — no manual step." },
];
const pipelineStats = [
  { n: 1000, label: "Tasks handled / month" },
  { n: 5, label: "Parallel workers" },
  { n: 30, label: "Minutes saved / recap" },
];

// Structured data: this is what lets a search engine render the name, role
// and links as an entity rather than as an anonymous blue link.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#person`,
      name: 'Toby',
      jobTitle: 'Creative Technologist',
      email: `mailto:${SITE.email}`,
      description: SITE.description,
      address: { '@type': 'PostalAddress', addressCountry: SITE.location },
      knowsAbout: stack,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
      publisher: { '@id': `${SITE.url}/#person` },
    },
  ],
};
---

<Base title={SITE.title} description={SITE.description} variant="descent" schema={schema}>

  <Fragment slot="prelude">
    <div class="boot" data-boot>
      <div class="boot-inner">
        <!-- The checklist is the progress indicator. Each line is a real
             signal the page is genuinely waiting on, so "still booting"
             always names the thing it is waiting for rather than showing a
             percentage that means nothing to anyone. -->
        <ol class="boot-checks" data-boot-checks>
          <li data-boot-check="signal"><span class="boot-dot"></span><span class="boot-label">Signal</span><span class="boot-state">····</span></li>
          <li data-boot-check="renderer"><span class="boot-dot"></span><span class="boot-label">Renderer</span><span class="boot-state">····</span></li>
          <li data-boot-check="field"><span class="boot-dot"></span><span class="boot-label">Field</span><span class="boot-state">····</span></li>
        </ol>
        <div class="boot-mark" data-boot-mark>TOBY</div>
        <div class="boot-role" data-boot-role>
          <span>Creative Technologist</span>
          <span class="boot-role-sub">Digital systems · Automation · Experiences</span>
        </div>
      </div>
    </div>

    <div class="cinema-stage" data-cinema aria-hidden="true">
      <canvas class="cinema-gl" data-cinema-gl></canvas>
    </div>

    <div class="boundary-iris" data-boundary-iris aria-hidden="true"></div>
  </Fragment>

  <span id="top"></span>

  <section class="hero" aria-label="Introduction">
    <div class="hero-fallback" aria-hidden="true"></div>
    <div class="wrap hero-content">
      <div class="eyebrow">TOBY — Creative Technologist</div>
      <h1>
        <span class="split-line"><span>I build digital</span></span>
        <span class="split-line"><span>systems &amp;</span></span>
        <span class="split-line"><span><em>experiences.</em></span></span>
      </h1>
      <div class="hero-sub glass">
        <p>Dashboards, automations and backend tools built inside a business's day-to-day operations — the invisible machinery behind a kitchen that runs on time.</p>
        <div class="hero-meta">
          <div><strong>Based in</strong> — Indonesia</div>
          <div><strong>Focus</strong> — Full-stack + automation</div>
          <div><strong>Stack</strong> — Python, JavaScript, Astro</div>
        </div>
      </div>
    </div>
    <div class="scroll-indicator">
      <span>Scroll</span>
      <span class="rail"></span>
    </div>
  </section>

  <section id="intro" class="identity-section" data-identity>
    <div class="id-scanline" aria-hidden="true"></div>
    <div class="id-surface-bloom" aria-hidden="true"></div>
    <div class="id-grid" aria-hidden="true" data-parallax="0.22"></div>
    <div class="wrap">
      <div class="eyebrow">01 — Identity · Who is behind the system</div>
      <div class="id-console glass" style="margin-top:26px;">
        <div class="id-terminal">
          {identityLines.map((line) => (
            <p class="id-line" data-id-line={line}>{line}</p>
          ))}
        </div>
        <div class="id-tags" aria-label="Capabilities">
          {identityTags.map((t) => <span class="id-tag" data-id-tag>{t}</span>)}
        </div>
      </div>
      <div class="intro-copy glass" data-reveal>
        <p>I work close to the ground — inside the actual workflow of a food business, not from a spec document. The tools I build get judged the same way the kitchen does: does it work today, under pressure, without babysitting.</p>
      </div>
    </div>
  </section>

  <section id="expertise" class="skills-section">
    <div class="wrap">
      <div class="section-head">
        <h2 data-split>The skill matrix</h2>
        <div class="eyebrow">02 — Network, not a list</div>
      </div>
    </div>
    <div class="skill-stage">
      <canvas id="skill-canvas"></canvas>
      <div class="skill-panel" data-skill-panel>
        <div class="eyebrow" style="margin-bottom:10px;">Skill</div>
        <h3 data-skill-name>—</h3>
        <p data-skill-desc>Hover a node to inspect it.</p>
        <div class="skill-related">
          <span class="eyebrow" style="margin-bottom:6px;">Related work</span>
          <p data-skill-related></p>
        </div>
      </div>
    </div>
    <p class="tech-note wrap" style="margin-top:28px;">A live constellation of what I actually work with — hover a node on desktop, or tap on touch, to see how it connects to real projects below.</p>
  </section>

  <section id="work" style="padding-inline:0;">
    <div class="wrap">
      <div class="section-head">
        <h2 data-split>Selected work</h2>
        <div class="eyebrow">03 — Featured projects</div>
      </div>
    </div>
    <div class="gallery-pin">
      <div class="gallery-viewport">
        <div class="gallery-track wrap">
          {projects.map((p, i) => (
            <a class="project-card" href={`/work/${p.id}/`} data-world={p.data.world} data-cursor="Case study">
              <div class="project-top">
                <span class="project-num">{String(i + 1).padStart(2, "0")}</span>
                <span class="project-tag">{p.data.tag}</span>
              </div>
              <div class="project-visual"><ProjectVisual world={p.data.world} /></div>
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
              <div class="project-impact">↳ {p.data.impact}</div>
              <div class="project-stack">
                {p.data.stack.map((s) => <span>{s}</span>)}
              </div>
              <span class="project-more">Read the case study →</span>
              <span class="project-sheen" aria-hidden="true"></span>
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="gallery-progress wrap">
      <div class="gallery-progress-bar"></div>
    </div>
  </section>

  <section aria-label="Automation pipeline" class="automation-section" data-automation>
    <div class="wrap">
      <div class="section-head">
        <h2 data-split>Machines I build</h2>
        <div class="eyebrow">04 — The automation factory</div>
      </div>
      <p class="tech-note" data-reveal style="margin-bottom:44px;">The business used to close each day with a manual recap, typed by hand. Here's the shape of what replaced it: data goes in one end, a decision happens in the middle, and a finished result comes out the other side — no one babysitting it.</p>

      <svg class="pipeline-svg" viewBox="0 0 1000 200" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <path data-flow-path d="M 40 100 C 200 100, 200 40, 340 40 C 480 40, 480 160, 620 160 C 760 160, 760 100, 960 100" fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="1.5" stroke-dasharray="2 8" stroke-linecap="round" />
        {[0,1,2,3,4,5].map(() => <circle data-flow-dot r="3.2" fill="#6FE8FF" />)}
      </svg>

      <div class="pipeline-stages">
        {pipelineStages.map((s) => (
          <div class="pipeline-stage" data-stage>
            <div class="pipeline-k">{s.k}</div>
            <p>{s.d}</p>
          </div>
        ))}
      </div>

      <div class="pipeline-stats">
        {pipelineStats.map((s) => (
          <div class="pipeline-stat">
            <div class="pipeline-stat-n"><span data-counter={s.n}>0</span>{s.label.includes('Minutes') ? '' : '+'}</div>
            <div class="pipeline-stat-l">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="tech" class="systems-section">
    <div class="wrap">
      <div class="section-head">
        <h2 data-split>Inside the machine</h2>
        <div class="eyebrow">05 — Systems &amp; stack</div>
      </div>
      <p class="tech-note" data-reveal style="margin-bottom:30px;">TOBY doesn't only design what you see. Every interface here sits on a stack that has to be understood layer by layer — UI, network, API, data, automation, output.</p>
      <div class="tech-cloud" data-tech-cloud>
        {stack.map((t) => <span class="tech-chip">{t}</span>)}
      </div>
      <p class="tech-note" data-reveal>This site is one of the experiments — built in Astro, animated with GSAP and ScrollTrigger, scrolled with Lenis, and rendered through a hand-written GLSL water shader on an OGL canvas. Reduced-motion and low-power devices get a simplified, static version automatically.</p>
    </div>
  </section>

  <section id="experience" class="evolution-section">
    <div class="wrap">
      <div class="section-head">
        <h2 data-split>The evolution</h2>
        <div class="eyebrow">06 — Timeline</div>
      </div>
      <div class="timeline" data-timeline>
        <div class="timeline-spine" aria-hidden="true">
          <span class="timeline-fill" data-timeline-fill></span>
        </div>
        {experience.map((e) => (
          <div class="timeline-row" data-reveal>
            <span class="timeline-node" aria-hidden="true"></span>
            <div class="timeline-when">{e.when}</div>
            <div>
              <h3>{e.title}</h3>
              <p>{e.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="transmission-section" data-transmission>
    <div class="wrap contact">
      <div class="eyebrow" style="justify-content:center;">07 — Transmission</div>
      <div class="transmission-console glass">
        <div class="transmission-status" data-transmission-status>ESTABLISHING CONNECTION…</div>
        <div class="transmission-bar-track"><div class="transmission-bar" data-transmission-bar></div></div>
        <div class="transmission-pct" data-transmission-pct>0%</div>
      </div>

      <h2 data-split data-transmission-reveal style="margin-top:32px;">Let's fix the next bottleneck together.</h2>
      <div class="transmission-tags" data-transmission-reveal>
        <span class="eyebrow" style="justify-content:center; margin-bottom:12px;">Available for</span>
        <div class="id-tags" style="justify-content:center;">
          {["WEB", "AUTOMATION", "AI", "3D", "SYSTEMS", "CREATIVE DEVELOPMENT"].map((t) => <span class="id-tag">{t}</span>)}
        </div>
      </div>
      <a class="contact-link magnetic" data-cursor="Send" data-transmission-reveal href={`mailto:${SITE.email}`}>INITIATE TRANSMISSION → {SITE.email}</a>
    </div>
  </section>

  <section class="final-cta shutdown-section" data-shutdown>
    <div class="shutdown-world" data-shutdown-world aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="wrap">
      <div class="eyebrow" style="justify-content:center;">Cycle complete</div>
      <p class="shutdown-line" data-shutdown-line style="margin-top:18px;">THANK YOU FOR DIVING IN.</p>
      <p class="shutdown-line" data-shutdown-line>OUTPUT DELIVERED — READY FOR THE NEXT SYSTEM</p>
      <h2 data-shutdown-closing class="shutdown-closing">TOBY<br /><em>Build. Break. Rebuild.</em></h2>
    </div>
  </section>

</Base>

<script>
  import '../scripts/boot.js';
</script>
