---
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { SITE } from '../consts';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

/**
 * A project's cover, by convention.
 *
 * Dropping `public/images/work/<id>.webp` is all it takes: the file is
 * matched to the project by its own id, so there is no frontmatter to keep
 * in sync and no way for the two to drift apart. An explicit `cover:` still
 * wins, for a file that does not follow the convention.
 */
function coverFor(entry: { id: string; data: { cover?: string } }) {
  if (entry.data.cover) return entry.data.cover;
  const path = `/images/work/${entry.id}.webp`;
  return existsSync(`public${path}`) ? path : undefined;
}

/**
 * The hover preview's image.
 *
 * `.work-preview` is position:fixed, so the browser counts it as on-screen
 * and `loading="lazy"` defers nothing: every preview is fetched on the
 * first paint whether or not a row is ever hovered. Serving the full cover
 * there would put the whole gallery on the critical path of the index page
 * for a panel about 270px wide.
 *
 * `npm run covers` writes a small 4:3 crop beside each cover; this uses it
 * when it exists and falls back to the cover when it does not, so a freshly
 * dropped image still works before the script has been run.
 */
function thumbFor(cover?: string) {
  if (!cover) return undefined;
  const thumb = cover.replace(/\.webp$/, '-thumb.webp');
  return existsSync(`public${thumb}`) ? thumb : cover;
}

// Every number on this page is derived from the content collection rather
// than typed in, so a new project updates the counters and nothing here can
// quietly drift out of date.
const allStack = [...new Set(projects.flatMap((p) => p.data.stack))];
const live = projects.filter((p) => p.data.status !== 'Retired');

const stats = [
  { n: projects.length, suffix: '', label: 'Projects shipped' },
  { n: live.length, suffix: '', label: 'Systems in use' },
  { n: allStack.length, suffix: '+', label: 'Tools in rotation' },
  { n: new Date().getFullYear(), suffix: '', label: 'Active', plain: true },
];

const skills = [
  { name: 'Automation', note: 'Scripts that remove a recurring manual step' },
  { name: 'Web Development', note: 'Astro, TypeScript, the front of the system' },
  { name: 'Backend & APIs', note: 'Python services, REST, scheduled jobs' },
  { name: 'Data & Reporting', note: 'Sheets, dashboards, the daily recap' },
  { name: 'Bots', note: 'Order handling and operational alerting' },
  { name: 'UI / UX', note: 'Interfaces built for people mid-service' },
  { name: 'Creative Development', note: 'Motion, WebGL, interactive work' },
  { name: 'AI', note: 'Applied where a rule would be too brittle' },
];

const experience = [
  {
    year: 'Ongoing',
    org: 'Operations & Automation',
    role: 'Creative Technologist',
    note: 'Embedded in day-to-day operations, building the dashboards, bots and reporting tools the team runs service on.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#person`,
      name: 'Toby',
      jobTitle: 'Creative Technologist',
      email: `mailto:${SITE.email}`,
      description: SITE.description,
      address: { '@type': 'PostalAddress', addressCountry: SITE.location },
      knowsAbout: allStack,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
      publisher: { '@id': `${SITE.url}/#person` },
    },
  ],
};
---

<Base title={SITE.title} description={SITE.description} schema={schema}>

  <span id="top"></span>

  <!-- ==================== HERO ==================== -->
  <section class="hero bleed" aria-label="Introduction" data-motion data-section="00" data-section-name="INDEX">
    <div class="grid hero-top">
      <h1 style="--c:6;">
        <span class="hero-slash" aria-hidden="true">/</span>
        <span class="hero-mark t-hero" data-hero-mark>
          <span class="hero-row"><span class="hero-char">T</span><span class="hero-char">O</span></span>
          <span class="hero-row"><span class="hero-char">B</span><span class="hero-char">Y</span></span>
        </span>
        <span class="sr-only">Toby, creative technologist</span>
      </h1>

      <div class="hero-say t-label" style="--c:4; --s:8;" data-hero-say>
        <p>CREATIVE TECHNOLOGIST</p>
        <p>DIGITAL SYSTEMS</p>
        <p>AUTOMATION &amp; TOOLING</p>
      </div>
    </div>

    <div class="grid hero-foot" data-hero-foot>
      <div class="hero-meta" style="--c:4;">
        <p class="t-tiny">CURRENTLY</p>
        <p class="t-label">Building operational tools in {SITE.location}</p>
      </div>
      <div class="hero-meta" style="--c:3; --s:6;">
        <p class="t-tiny">INDEX</p>
        <p class="hero-index">
          <span class="t-counter" data-odometer>{String(projects.length).padStart(2, "0")}</span>
          <span class="unit t-muted">/ PROJECTS</span>
        </p>
      </div>
      <a class="hero-scroll link t-label" style="--c:3; --s:10;" href="#about">
        <span>SCROLL DOWN</span><i class="arrow">↓</i>
      </a>
    </div>
  </section>

  <!-- ==================== 01 / ABOUT ==================== -->
  <section id="about" class="section bleed" data-motion data-section="01" data-section-name="ABOUT">
    <SectionLabel num="01" name="About" />
    <div class="grid about">
      <p class="t-lg" style="--c:7; --s:5;" data-split>
        Creative technologist building the machinery a business runs on.
      </p>
      <div class="about-body" style="--c:5; --s:5;">
        <p class="t-body" data-reveal>
          I work close to the ground, inside the actual workflow of a food business, not from a
          spec document. The tools I build get judged the same way the kitchen does: does it work
          today, under pressure, without anyone babysitting it.
        </p>
        <p class="t-body" data-reveal>
          That means dashboards people read mid-service, bots that handle the orders nobody has
          time to retype, and reports that file themselves. Front to back, the same hands.
        </p>
      </div>
      <div class="about-meta" style="--c:3; --s:10;">
        <div data-reveal>
          <p class="t-tiny">ROLE</p>
          <p class="t-label">Creative Technologist</p>
        </div>
        <div data-reveal>
          <p class="t-tiny">BASED IN</p>
          <p class="t-label">{SITE.location}</p>
        </div>
        <div data-reveal>
          <p class="t-tiny">STATUS</p>
          <p class="t-label t-accent">Available for work</p>
        </div>
      </div>
    </div>

    <ul class="grid stats">
      {stats.map((s) => (
        <li class="stat" style="--c:3; --c-m:2;" data-reveal>
          <p class="t-counter">
            <span data-odometer>{s.plain ? String(s.n) : String(s.n).padStart(2, "0")}{s.suffix}</span>
          </p>
          <p class="t-tiny">{s.label}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ==================== 02 / SELECTED WORK ==================== -->
  <section id="work" class="section bleed" data-motion data-section="02" data-section-name="SELECTED WORK">
    <SectionLabel num="02" name="Selected Work" />
    <!-- One preview panel shared by every row. Each frame is the project's
         own screenshot when it has one, and a typographic plate built from
         its number, title and category when it does not, so the interaction
         is real before the photography exists. -->
    <div class="work-preview" data-work-preview aria-hidden="true">
      {projects.map((p, i) => (
        <figure class="work-frame" data-preview={p.id}>
          {coverFor(p)
            ? <img src={thumbFor(coverFor(p))} alt="" decoding="async" width="600" height="450" />
            : (
              <div class="work-plate on-dark">
                <span class="t-counter">{String(i + 1).padStart(2, '0')}</span>
                <span class="t-label work-plate-title">{p.data.title}</span>
                <span class="t-tiny">{p.data.tag}, {p.data.timeframe}</span>
              </div>
            )}
        </figure>
      ))}
    </div>

    <ul class="work-list" data-work-list>
      {projects.map((p, i) => (
        <li class="work-row">
          <a href={`/work/${p.id}/`} data-work-row data-preview={p.id} data-cursor="project">
            <span class="work-num t-counter" data-odometer>{String(i + 1).padStart(2, '0')}</span>
            <span class="work-title t-lg">{p.data.title}</span>
            <span class="work-cat t-label t-muted">{p.data.tag}</span>
            <span class="work-year t-label t-muted">{p.data.timeframe}</span>
            <span class="work-go t-label" aria-hidden="true">&gt;</span>
          </a>
          <hr class="rule" data-rule />
        </li>
      ))}
    </ul>
  </section>

  <!-- ==================== 03 / EXPERIENCE ==================== -->
  <section id="experience" class="section bleed" data-motion data-section="03" data-section-name="EXPERIENCE">
    <SectionLabel num="03" name="Experience" />
    <ul class="exp-list">
      {experience.map((e) => (
        <li class="exp-row">
          <hr class="rule" data-rule />
          <div class="exp-inner" data-reveal>
            <span class="t-counter exp-year">{e.year}</span>
            <span class="t-lg exp-org">{e.org}</span>
            <span class="t-label t-muted exp-role">{e.role}</span>
            <p class="t-body exp-note">{e.note}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- ==================== 04 / SKILLS ==================== -->
  <section id="skills" class="section bleed" data-motion data-section="04" data-section-name="SKILLS">
    <SectionLabel num="04" name="Skills" />
    <ul class="skill-list">
      {skills.map((s, i) => (
        <li class="skill-row" data-reveal>
          <hr class="rule" data-rule />
          <div class="skill-inner">
            <span class="t-label t-muted skill-num" data-odometer>{String(i + 1).padStart(2, '0')}</span>
            <span class="t-label skill-name">{s.name}</span>
            <span class="t-label t-muted skill-note">{s.note}</span>
            <span class="t-label skill-go" aria-hidden="true">&gt;</span>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- ==================== 05 / TECHNOLOGY ==================== -->
  <!-- The one inverted block in the document. The archive is the right
       section for it: it is a list of names rather than an argument, so the
       reader loses nothing by it going quiet and dark before the contact
       block, and the page gains a beat it does not otherwise have. -->
  <section id="technology" class="section bleed on-dark" data-motion data-cursor-theme="dark" data-section="05" data-section-name="TECHNOLOGY">
    <SectionLabel num="05" name="Technology" />
    <ul class="grid tech-list">
      {allStack.map((t, i) => (
        <li class="tech-item" style="--c:3; --c-m:2;" data-reveal>
          <span class="t-tiny" data-odometer>{String(i + 1).padStart(2, '0')} /</span>
          <span class="t-label">{t}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- ==================== / CONTACT ==================== -->
  <section id="contact" class="section bleed contact" data-motion data-section="06" data-section-name="CONTACT">
    <SectionLabel num="06" name="Contact" slash />
    <h2 class="t-md contact-head" data-split>/ CONTACT</h2>
    <div class="grid contact-grid">
      <div style="--c:5;">
        <p class="t-tiny">EMAIL</p>
        <a class="link t-lg contact-mail" href={`mailto:${SITE.email}`}>
          <span>{SITE.email}</span><i>&gt;</i>
        </a>
      </div>
      <div class="contact-cols" style="--c:5; --s:8;">
        <div>
          <p class="t-tiny">GITHUB</p>
          <a class="link t-label" href="https://github.com/hermanlim0623-cloud"><span>@hermanlim0623</span><i>&gt;</i></a>
        </div>
        <div>
          <p class="t-tiny">LOCATION</p>
          <p class="t-label">{SITE.location}</p>
        </div>
      </div>
    </div>
  </section>

</Base>
