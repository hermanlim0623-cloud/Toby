<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Toby — Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="wrap">

  <header class="site">
    <div class="brand">Toby</div>
    <nav>
      <a href="#work">Work</a>
      <a href="#services">What I do</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero">
    <div class="eyebrow">Operations · Reporting · Automation</div>
    <h1>I build the tools<br>that keep the kitchen<br><em>running on time.</em></h1>
    <div class="hero-sub">
      <p>I work inside Pawby Kitchen's day-to-day operations — turning manual tracking, spreadsheets, and recurring reports into dashboards and small tools the team actually uses.</p>
      <div class="hero-meta">
        <div><strong>Based in</strong> — Indonesia</div>
        <div><strong>Focus</strong> — F&amp;B operations tooling</div>
        <div><strong>Stack</strong> — Python, HTML/CSS, automation scripts</div>
      </div>
    </div>
  </section>

  <section id="services">
    <div class="section-head">
      <h2>What I do</h2>
      <div class="eyebrow">03 areas</div>
    </div>
    <div class="services-grid">
      {services.map((s) => (
        <div class="service">
          <div class="num">{s.num}</div>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="process">
    <div class="section-head">
      <h2>How I work</h2>
      <div class="eyebrow">4 steps</div>
    </div>
    <div class="process">
      {process.map((p) => (
        <div class="process-step">
          <div class="step-index">{p.index}</div>
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="work">
    <div class="section-head">
      <h2>Selected work</h2>
      <div class="eyebrow">7 projects</div>
    </div>
    <div class="work-list">
      {work.map((w) => (
        <div class="work-row">
          <div class="work-info">
            <div class="work-tag">{w.tag}</div>
            <h3>{w.title}</h3>
            <p>{w.desc}</p>
            <div class="work-impact">{w.impact}</div>
          </div>
          <div class="shot" data-label="Screenshot"></div>
        </div>
      ))}
    </div>
  </section>

  <footer id="contact">
    <h2>Let's fix the next bottleneck together.</h2>
    <div class="footer-contact">
      <div class="eyebrow">Get in touch</div>
      <a href="mailto:hermanlim.0623@gmail.com">hermanlim.0623@gmail.com</a>
    </div>
    <div class="foot-note">
      <span>Toby — Operations &amp; Automation</span>
      <span>Built for Pawby Kitchen</span>
    </div>
  </footer>

</div>

<script src="/script.js" is:inline></script>
</body>
</html>
