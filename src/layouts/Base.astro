---
import '@fontsource-variable/inter';
import '@fontsource-variable/martian-mono';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>;
}

const { title, description = SITE.description, image, type, schema } = Astro.props;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en" class="is-loading">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="generator" content={Astro.generator} />

  <Seo title={title} description={description} image={image} type={type} schema={schema} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#F4F4F4" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <ClientRouter />
</head>
<body>

<!-- The opening. aria-hidden and inert: it is a curtain over content that
     is already there, and a screen reader should be reading the page, not
     describing the curtain. -->
<div class="loader on-dark" data-cursor-theme="dark" data-loader aria-hidden="true" inert>
  <div class="loader-inner bleed" data-loader-inner>
    <p class="loader-mark t-md">TOBY</p>
    <div class="loader-row">
      <p class="t-tiny">SYSTEM INITIALISING</p>
      <ol class="loader-steps">
        {['GRID', 'TYPE', 'INDEX', 'MOTION', 'READY'].map((step, i) => (
          <li class="t-tiny" data-loader-step>
            <span>{String(i + 1).padStart(2, '0')}</span> {step}
          </li>
        ))}
      </ol>
    </div>
    <div class="loader-track"><span class="loader-bar" data-loader-bar></span></div>
    <p class="t-label loader-pct" data-loader-pct>000%</p>
  </div>
</div>

<!-- The staircase transition's cover. It lives in the layout with
     transition:persist because the router replaces document.body on every
     swap: created from script it would be destroyed by the first navigation
     and the mechanism would work exactly once. Persisting keeps the same
     live node, so an animation in flight survives the swap it is hiding. -->
<div class="st" data-stairs aria-hidden="true" transition:persist="stairs">
  <span class="st-step" data-stair></span>
  <span class="st-step" data-stair></span>
  <span class="st-step" data-stair></span>
  <span class="st-step" data-stair></span>
  <span class="st-step" data-stair></span>
</div>

<a class="skip-link t-label" href="#main">SKIP TO CONTENT</a>

<Header />
<div class="progress" aria-hidden="true"><span class="progress-bar" data-progress></span></div>

<main id="main">
  <slot />
</main>

<footer class="foot on-dark" data-cursor-theme="dark">
  <!-- The footer's hidden field: a full plate of accent carrying the
       repeated wordmark, masked to nothing and found by dragging across it.
       Decorative and inert, and behind the content at every point: the
       wordmark is already the page's h1, so repeating it to a screen reader
       would only read the name a hundred more times. -->
  <div class="foot-fx" data-foot-ink aria-hidden="true">
    <canvas class="foot-fx-canvas" data-foot-ink-canvas></canvas>
  </div>
  <div class="bleed">
    <div class="grid foot-top">
      <div style="--c:4;">
        <span class="hero-slash" aria-hidden="true">/</span>
        <p class="t-md">TO<br />BY</p>
      </div>
      <div class="foot-cols" style="--c:5; --s:7;">
        <div>
          <p class="t-tiny">EMAIL</p>
          <a class="link t-label" href={`mailto:${SITE.email}`}><span>{SITE.email}</span><i>&gt;</i></a>
        </div>
        <div>
          <p class="t-tiny">BASED IN</p>
          <p class="t-label">{SITE.location}</p>
        </div>
      </div>
    </div>
    <div class="grid foot-bottom">
      <p class="t-tiny" style="--c:6;">© {year} {SITE.name}, ALL RIGHTS RESERVED</p>
      <p class="t-tiny foot-sign" style="--c:6;">/{String(year).slice(-2)}</p>
    </div>
  </div>
</footer>

<script>
  import '../scripts/main.js';
</script>

</body>
</html>
