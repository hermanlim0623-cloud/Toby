---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import Atmosphere from '../components/Atmosphere.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>;
  /** `descent` mounts the generated environment; `page` is the lighter shell. */
  variant?: 'descent' | 'page';
}

const {
  title,
  description = SITE.description,
  image,
  type,
  schema,
  variant = 'page',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="generator" content={Astro.generator} />

  <Seo title={title} description={description} image={image} type={type} schema={schema} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#021827" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <ClientRouter />
</head>
<body data-variant={variant}>

<!-- A keyboard visitor should not have to tab through the entire nav and
     an atmosphere of decorative layers before reaching the content. -->
<a class="skip-link" href="#main">Skip to content</a>

<slot name="prelude" />

<Atmosphere depthHud={variant === 'descent'} />
<Nav />
<CommandPalette />

<main id="main">
  <slot />
</main>

<footer class="site-foot">
  <div class="wrap site-foot-inner">
    <span>Toby — Operations &amp; Automation</span>
    <span>Built for real operations</span>
  </div>
</footer>

</body>
</html>
