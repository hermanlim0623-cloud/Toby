---
import '@fontsource-variable/inter';
import '@fontsource-variable/martian-mono';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>;
}

const { title, description = SITE.description, image, type, schema } = Astro.props;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="generator" content={Astro.generator} />

  <Seo title={title} description={description} image={image} type={type} schema={schema} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#F4F4F4" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <ClientRouter />
</head>
<body>

<a class="skip-link t-label" href="#main">SKIP TO CONTENT</a>

<Header />

<main id="main">
  <slot />
</main>

<footer class="foot on-dark">
  <div class="bleed">
    <div class="grid foot-top">
      <div style="--c:4;">
        <span class="hero-slash" aria-hidden="true">/</span>
        <p class="t-md">TO<br />BY</p>
      </div>
      <div class="foot-cols" style="--c:5; --s:7;">
        <div>
          <p class="t-tiny">EMAIL</p>
          <a class="link t-label" href={`mailto:${SITE.email}`}><span>{SITE.email}</span><i>&gt;</i></a>
        </div>
        <div>
          <p class="t-tiny">BASED IN</p>
          <p class="t-label">{SITE.location}</p>
        </div>
      </div>
    </div>
    <div class="grid foot-bottom">
      <p class="t-tiny" style="--c:6;">© {year} {SITE.name} — ALL RIGHTS RESERVED</p>
      <p class="t-tiny foot-sign" style="--c:6;">/{String(year).slice(-2)}</p>
    </div>
  </div>
</footer>

<script>
  import '../scripts/main.js';
</script>

</body>
</html>
