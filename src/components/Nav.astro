---
import { NAV_LINKS } from '../consts';
---

<nav class="nav" aria-label="Primary">
  <a href="/#top" class="nav-brand">TOBY<span>.</span></a>
  <ul class="nav-links">
    {NAV_LINKS.map((l) => (
      <li><a href={l.href}>{l.label}</a></li>
    ))}
  </ul>
  <div class="nav-end">
    <!-- The palette is the fastest way around this site, so it gets a
         visible affordance rather than being a shortcut only its author
         knows about. -->
    <button class="nav-key" data-palette-open aria-label="Open command palette">
      <kbd>⌘</kbd><kbd>K</kbd>
    </button>
    <a class="nav-cta magnetic" href="/#contact">Get in touch</a>
  </div>
  <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  </button>
</nav>

<div class="mobile-menu" id="mobile-menu" inert>
  {NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
  <a href="/#contact">Contact</a>
</div>
