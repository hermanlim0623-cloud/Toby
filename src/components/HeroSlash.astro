---
/**
 * The hero's cursor-driven slash.
 *
 * A diagonal band carrying the wordmark, revealed by moving the pointer and
 * fading out again when it stops. It is an interaction rather than a
 * background: at rest the hero is exactly as it was.
 *
 * Decorative and inert. The wordmark is already in the hero's h1, so
 * repeating it here would only make a screen reader read the name twelve
 * times.
 */
const REPEATS = 14;
---

<div class="hero-fx" data-hero-slash aria-hidden="true">
  <div class="hero-fx-band" data-hero-slash-band>
    <div class="hero-fx-type">
      {Array.from({ length: REPEATS }, () => <span>TOBY</span>)}
    </div>
  </div>
</div>
