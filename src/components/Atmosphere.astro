---
interface Props {
  /** The layer readout only means something on the long scrolling descent. */
  depthHud?: boolean;
}
const { depthHud = false } = Astro.props;
---

<div class="scrim" aria-hidden="true"></div>
<div class="atmosphere" aria-hidden="true"></div>
<div class="caustics" aria-hidden="true"></div>
<div class="bubbles" id="bubbles" aria-hidden="true"></div>
<div class="grain" aria-hidden="true"></div>
<div class="progress-rail" aria-hidden="true"><span data-progress-rail></span></div>
{depthHud && (
  <div class="depth-hud" aria-hidden="true">
    <span>LAYER</span>
    <strong data-depth-meters>01 / 7</strong>
    <span class="depth-hud-name" data-layer-name>IDENTITY</span>
  </div>
)}
